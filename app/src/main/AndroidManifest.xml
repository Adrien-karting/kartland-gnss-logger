<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB Host mode is how we talk to the external GNSS dongle over the USB-C OTG link. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Only needed pre-Android 10 for writing the CSV log outside app-specific storage;
         harmless to keep for older test devices. App targets scoped storage via
         getExternalFilesDir() by default, see CsvLogger.kt. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KartlandGnssLogger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets Android auto-launch this app when the GNSS dongle is plugged in,
                 instead of relying on the user to open it first and then plug in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Used by the "Share" button to hand the CSV log to another app (Drive, email,
             the analysis pipeline, etc.) without exposing a raw file:// path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kartland.gnsslogger.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
